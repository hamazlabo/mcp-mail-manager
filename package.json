{
  "name": "mcp-mail-manager",
  "version": "0.1.0",
  "private": true,
  "description": "AI エージェントとメールサーバ (IMAP/SMTP) を連携するリモート MCP サーバ",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
